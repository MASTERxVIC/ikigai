# ikigaicoding — environment variables.
# Copy to .env.local for local dev (never commit .env.local).
# Placeholders ONLY below — replace each <...> with a real value of your own.
# Never paste a real secret into chat, git, or a shared file.

# MongoDB Atlas connection string. Database name MUST be `ikigaicoding`
# (lib/db.js reads that db; the admin panel and public pages share it).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/ikigaicoding?retryWrites=true&w=majority

# Signs the admin session cookie (HMAC-SHA256). At least 32 random
# characters — generate one locally, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# If this is missing or shorter than 32 chars, login returns a 500.
ADMIN_SESSION_SECRET=<at-least-32-random-characters>

# One-time gate for /api/admin/setup. A long random code you generate
# locally (same command as above works). Needed only until setup is done;
# keep it private — anyone with it can start owner setup on a fresh db.
ADMIN_SETUP_CODE=<long-random-code-you-generate-locally>
